# Required runtime settings. Generate SECRET_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=3000
MONGO_URI=mongodb://localhost:27017/ultracare
SECRET_KEY=

# Optional ML helper settings.
ML_URL=http://localhost:5001
# ML_PYTHON_COMMAND=python

# Fast2SMS OTP credentials. Get the OTP template ID from your Fast2SMS account.
FAST2SMS_KEY=
FAST2SMS_OTP_ID=

# Optional email settings. For Gmail, use a Google App Password, not your
# normal account password. Remove spaces from the 16-character App Password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay test-mode credentials. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
